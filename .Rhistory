base_brasil %>%
mutate(anio_def = year(dmy(DTOBITO)),
color = case_when(
`Nome Região Geográfica Imediata` %in% c("Uruguaiana",
"São Borja",
"São Luiz Gonzaga",
"Cerro Largo",
"Santa Rosa",
"Três de Maio",
"Três Passos",
"São Miguel do Oeste",
"Francisco Beltrão",
"Foz do Iguaçu") ~ "Frontera",
.default = "No frontera")) %>%
#filter(Nome_UF == "Paraná") %>%  #"Santa Catarina","Rio Grande do Sul"
#filter(Nome_UF == "Santa Catarina") %>%
filter(Nome_UF == "Rio Grande do Sul") %>%
count(anio_def,`Nome Região Geográfica Imediata`,color) %>%
ggplot(aes(x = anio_def, y = n, col = color))+
geom_line()+
geom_point()+
ylim(0,NA)+
facet_wrap(~`Nome Região Geográfica Imediata`,scale = "free_y")
