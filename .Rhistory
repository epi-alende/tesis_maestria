## El año 2018 tiene mucho sin dato ----
#a <- base_argentina %>% count(depoc_nombre)
base_argentina %>%
#filter(stringr::str_sub(codmuer,1,3) == "C53") %>%
filter(provoc_nombre == "Misiones") %>%
count(anio_def,depoc_nombre) %>%
mutate(color = case_when(
depoc_nombre %in% c("Iguazú","General Manuel Belgrano",
"San Pedro","Guaraní",
"25 de Mayo","Oberá",
"San Javier","Concepción",
"Apóstoles",
"Santo Tomé","General Alvear",
"San Martín","Paso de los Libres",
"Monte Caseros") ~ "Frontera",
.default = "No frontera")) %>%
ggplot(aes(x = anio_def, y = n, col = color))+
geom_line()+
geom_point()+
ylim(0,NA)+
facet_wrap(~depoc_nombre,scale = "free_y")+
scale_x_continuous(breaks = scales::breaks_width(2))+
labs(x = "Año defunción", y = "Defunciones por CCU", title = "Misiones")+
theme_minimal()+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1,size = 7))
