library(sf)
library(dplyr)
library(ggplot2)
source("Brasil.R")
source("Argentina.R")
base_argentina %>%
#filter(stringr::str_sub(codmuer,1,3) == "C53") %>%
count(anio_def,provoc_nombre) %>%
ggplot(aes(x = anio_def, y = n))+
geom_line()+
geom_point()+
ylim(0,NA)+
facet_wrap(~provoc_nombre,scale = "free_y")
base_argentina %>%
#filter(stringr::str_sub(codmuer,1,3) == "C53") %>%
count(anio_def,provoc_nombre) %>%
ggplot(aes(x = anio_def, y = n))+
geom_line()+
geom_point()+
ylim(0,NA)+
facet_wrap(~provoc_nombre,scale = "free_y")
